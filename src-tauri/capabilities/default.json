{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/kelvinlim/audio-compare" },
        { "url": "https://github.com/kelvinlim/audio-compare/*" }
      ]
    },
    "dialog:default"
  ]
}
