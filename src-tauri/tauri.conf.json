{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Audio Compare",
  "version": "0.2.0",
  "identifier": "com.kolim.audiocompare",
  "build": {
    "beforeDevCommand": "npm run prepare-ffmpeg && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare-ffmpeg && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Audio Compare",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/ffmpeg"],
    "resources": {
      "../assets/tracks": "tracks/"
    }
  }
}
